# The Reddening — environment

# Auth (Clerk). Leave unset + DEV_BYPASS_AUTH=true for local authoring.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
VERONIKA_USER_ID=
VERONIKA_EMAIL=
DEV_BYPASS_AUTH=true

# Database — Turso. Falls back to local file:local.db when unset.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# File storage (Vercel Blob). Optional for local; portraits/audio need this in prod.
BLOB_READ_WRITE_TOKEN=

# AI (Skriptorium: Revenant drafts, etc.)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
