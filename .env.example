# The Reddening — environment

# Auth (Clerk). Leave unset + DEV_BYPASS_AUTH=true for local authoring.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
VERONIKA_USER_ID=
VERONIKA_EMAIL=
DEV_BYPASS_AUTH=true

# Database — Turso. Falls back to local file:local.db when unset.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# File storage (Vercel Blob). Optional for local; portraits/audio need this in prod.
BLOB_READ_WRITE_TOKEN=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Cast photoreal vampire portraits (FLUX Kontext). At least one required for /api/portrait.
FAL_KEY=
# Optional: auto | pro | dev. auto tries Pro then free-er Kontext-dev on the same FAL_KEY.
PORTRAIT_MODEL=auto
# Optional: auto | fal | hf | replicate. Use hf to skip paid fal when out of credits.
PORTRAIT_PROVIDER=auto
# Free-tier via Hugging Face Inference Providers → FLUX.1-Kontext-dev.
# Create a token with "Make calls to Inference Providers" permission:
# https://huggingface.co/settings/tokens
HF_TOKEN=
# Optional paid fallback if FAL_KEY / HF_TOKEN are unset or fail.
REPLICATE_API_TOKEN=
